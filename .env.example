# ── Cloud API (cloud/api) ─────────────────────────────────────────────
# PostgreSQL connection string (Railway provides DATABASE_URL automatically
# when the Postgres plugin is attached)
DATABASE_URL=postgresql://user:password@localhost:5432/brandinbold

# JWT signing secret — generate with: openssl rand -base64 48
JWT_SECRET=

# Cloud API port (Railway sets PORT automatically)
PORT=8787

# ── Cloud Web (cloud/web) ─────────────────────────────────────────────
# URL the landing/dashboard uses to reach the API
VITE_API_URL=http://localhost:8787
# Public web URL used by the API to build team invite links (#/invite?token=...)
CLOUD_WEB_URL=https://cloud-web-production-f49c.up.railway.app

# ── Team Invitations & Email Delivery (optional — falls back to copyable invite link) ──
# Option A: Resend HTTP API
# RESEND_API_KEY=re_xxxxxxxxx
# Option B: SMTP (Host / Port / User / Pass)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=secret
# INVITE_FROM_EMAIL=Brandinbold <noreply@brandinbold.app>
# Optional override for max team seats per workspace (defaults: free=3, pro=10, team=50)
# MAX_TEAM_SEATS=

# ── Desktop app (optional — overrides default production cloud API URL) ──
# BRANDINBOLD_CLOUD_API_URL=https://cloud-api-production-8852.up.railway.app
