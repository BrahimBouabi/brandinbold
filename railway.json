# Railway deployment — Brandinbold Cloud
# Each service builds from its own Dockerfile. Railway auto-detects the root
# directory when connecting a monorepo — set "Root Directory" per service in
# the dashboard (cloud/api and cloud/web), or deploy each via this config.

[build]
builder = "DOCKERFILE"

[deploy]
# Railway injects PORT; the API listens on it automatically
startCommand = "node dist/index.js"
healthcheckPath = "/api/health"
healthcheckTimeout = 60
restartPolicyType = "ON_FAILURE"
restartPolicyMaxRetries = 5
